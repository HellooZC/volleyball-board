rules_version = '2';

// 战术板的 Firestore 安全规则。
// 只有名单里的邮箱可以读写；要加 / 删教练，改下面的名单再按“发布”。
// 邮箱一律写小写。
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        'coach1@example.com',
        'coach2@example.com'
      ];
    }

    match /teams/{id} {
      allow read, write: if allowed();
    }
    match /matches/{id} {
      allow read, write: if allowed();
    }
  }
}

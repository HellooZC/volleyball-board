rules_version = '2';

// 战术板的 Firestore 安全规则（不用登录版）。
// 打开网站的人都能读写 teams / matches 两个集合；其他集合一律拒绝，
// 写入时检查资料格式和大小，避免被拿来乱存东西。
service cloud.firestore {
  match /databases/{database}/documents {
    function ours(c) {
      return c in ['teams', 'matches'];
    }
    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['json', 'updatedAt', 'by'])
        && d.json is string
        && d.json.size() < 900000
        && d.updatedAt is number;
    }

    match /{collection}/{id} {
      allow read, delete: if ours(collection);
      allow create, update: if ours(collection) && validDoc();
    }
  }
}
